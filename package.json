{
    "name": "worklabs",
    "version": "0.1.0",
    "private": true,
    "description": "Single place for jobs listing and finding jobs",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev:api": "npm run dev --workspace @worklabs/api",
        "dev:web": "npm run dev --workspace @worklabs/web",
        "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\""
    },
    "engines": {
        "node": "24.18.0"
    },
    "packageManager": "npm@11.16.0",
    "devDependencies": {
        "concurrently": "^10.0.5"
    }
}
